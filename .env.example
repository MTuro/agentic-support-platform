# Generate a local token with: python -c 'import secrets; print(secrets.token_urlsafe(32))'
# Never use this blank template as a deployed credential.
AGENT_SERVICE_TOKEN=
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=20
KNOWLEDGE_DIR=data/knowledge
TICKETS_FILE=data/tickets.json
CHROMA_DIR=.data/chroma

# M2: public LoopBack API. Generate credentials with npm run demo:env in apps/api.
# Source ignored .data/api.env and .data/database.env, or configure manually.
DATABASE_URL=
DEMO_IDENTITIES=
AGENT_URL=http://127.0.0.1:8001
AGENT_TIMEOUT_MS=90000
PORT=8000
